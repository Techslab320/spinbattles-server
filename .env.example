# Copy to .env for local: npm run dev
# On Vercel: set these in Project → Settings → Environment Variables

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/spinbattles?retryWrites=true&w=majority
# If password contains @ encode it as %40

ADMIN_EMAIL=hr@spinbattles.com
ADMIN_PASSWORD=your-secure-password
ADMIN_SESSION_SECRET=change-to-a-long-random-string

# Frontend URL(s) allowed for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:3000
# Add production frontend later, or use comma list in CLIENT_ORIGINS on app if supported

# Local only (Vercel ignores this)
API_PORT=3002
